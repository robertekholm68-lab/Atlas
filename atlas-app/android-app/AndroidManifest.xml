<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="se.atlas.app"
    android:versionCode="1"
    android:versionName="2.0">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Normal behörighet, beviljas vid installation utan dialog. En kort puls
         när mikrofonen börjar lyssna är den enda återkoppling som når fram med
         musik i lurarna och blicken på stången. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- KAMERA för streckkodsläsaren i matloggen. onPermissionRequest beviljar
         redan allt sidan ber om, men Android kräver att appen DEKLARERAR
         behörigheten — utan den får getUserMedia samma tysta nej som mikrofonen
         fick, med samma vilseledande felmeddelande. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- required=false: en telefon utan kamera ska fortfarande kunna installera
         appen. Streckkoden är en av många vägar att logga mat, inte den enda. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:label="Askr"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
